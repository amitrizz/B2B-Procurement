# Backend — PRODUCTION (live)
# Copy:  copy .env.prod.example .env.prod
# Run:   npm run start:prod   (after npm run build:prod)
# Check: npm run env:check:prod

DEPLOYMENT_ENV=production
NODE_ENV=production

FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/b2b-procurement

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
EMAIL_VERIFY_REQUIRED=false

PLATFORM_LEGAL_NAME=Your Company Legal Name Pvt Ltd
PLATFORM_GSTIN=27XXXXXXXXXXXXX
PLATFORM_STATE=Maharashtra

BANK_HASH_PEPPER=REPLACE_WITH_LONG_RANDOM_PEPPER

CASHFREE_ENV=production
CASHFREE_APP_ID=REPLACE_LIVE_PG_APP_ID
CASHFREE_SECRET_KEY=REPLACE_LIVE_PG_SECRET
CASHFREE_API_VERSION=2025-01-01
CASHFREE_WEBHOOK_SECRET=
CASHFREE_VERIFY_WEBHOOKS=true

SUPPLIER_PAYOUT_MODE=ledger
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_API_VERSION=2024-01-01

CENTRIFUGO_URL=https://realtime.your-domain.com
CENTRIFUGO_API_KEY=REPLACE
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=REPLACE

# Cashfree webhook URL: {BACKEND_URL}/api/v1/payments/cashfree/webhook
