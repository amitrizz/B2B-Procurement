# =============================================================================
# Render.com → Centrifugo service → Environment
# Service: https://centrifugo-latest-31xv.onrender.com
#
# Logs "API key is empty" → set CENTRIFUGO_HTTP_API_KEY (v6 name, NOT CENTRIFUGO_API_KEY)
# Logs "empty allowed_origins" → set CENTRIFUGO_CLIENT_ALLOWED_ORIGINS
#
# Must match backend/.env.dev:
#   CENTRIFUGO_API_KEY=my-super-secret-api-key-2026
#   CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=my-super-secret-hmac-key-2026
# =============================================================================

CENTRIFUGO_HTTP_API_KEY=my-super-secret-api-key-2026
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=my-super-secret-hmac-key-2026
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=http://127.0.0.1:3000 http://localhost:3000 https://b2bprocurementui.vercel.app
CENTRIFUGO_CHANNEL_WITHOUT_NAMESPACE_ALLOW_SUBSCRIBE_FOR_CLIENT=true

# After adding: Render → Save → Manual Deploy (or Save and deploy)
# Verify locally:  cd backend && npm run centrifugo:test:render

# --- If your Render image is Centrifugo v5 (not v6/latest), use these instead: ---
# CENTRIFUGO_API_KEY=my-super-secret-api-key-2026
# CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=my-super-secret-hmac-key-2026
# CENTRIFUGO_ALLOWED_ORIGINS=http://127.0.0.1:3000 http://localhost:3000 https://b2bprocurementui.vercel.app
