{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-env.mjs dev next dev -p 3001",
    "dev:prod": "node scripts/run-env.mjs prod next dev -p 3001",
    "build": "node scripts/run-env.mjs prod next build",
    "build:dev": "node scripts/run-env.mjs dev next build",
    "build:prod": "node scripts/run-env.mjs prod next build",
    "start": "node scripts/run-env.mjs prod next start -p 3001",
    "start:dev": "node scripts/run-env.mjs dev next start -p 3001",
    "start:prod": "node scripts/run-env.mjs prod next start -p 3001",
    "lint": "eslint",
    "env:init": "node scripts/init-env.mjs",
    "env:check": "node scripts/run-env.mjs dev tsx scripts/check-env.ts",
    "env:check:prod": "node scripts/run-env.mjs prod tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "minio": "^8.0.7",
    "mongoose": "^9.9.4",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
